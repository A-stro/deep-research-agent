{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "research-report.schema.json",
  "title": "ResearchReport",
  "description": "Stage 04 output. The structured report is the primary artifact; report.md is a rendering of it, never a second source of facts. Every finding cites evidence IDs that exist in the EvidenceBundle.",
  "type": "object",
  "required": ["artifact", "run_id", "query", "executive_summary", "key_findings", "detailed_analysis", "conflicts", "uncertainties_gaps", "actionable_insights", "sources", "gate"],
  "additionalProperties": false,
  "properties": {
    "artifact": { "enum": ["ResearchReport"] },
    "run_id": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])-[a-z0-9-]+$" },
    "query": { "type": "string", "minLength": 1 },
    "executive_summary": { "type": "string", "minLength": 1 },
    "key_findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["finding", "evidence_ids"],
        "additionalProperties": false,
        "properties": {
          "finding": { "type": "string", "minLength": 1 },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^E[0-9]+$" }
          }
        }
      }
    },
    "detailed_analysis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["question_id", "analysis"],
        "additionalProperties": false,
        "properties": {
          "question_id": { "type": "string", "pattern": "^RQ[0-9]+$" },
          "analysis": { "type": "string", "minLength": 1 }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description"],
        "additionalProperties": false,
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "evidence_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^E[0-9]+$" }
          }
        }
      }
    },
    "uncertainties_gaps": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "actionable_insights": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_title", "source_url", "evidence_ids"],
        "additionalProperties": false,
        "properties": {
          "source_title": { "type": "string", "minLength": 1 },
          "source_url": { "type": "string", "pattern": "^https?://" },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^E[0-9]+$" }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "gate": { "$ref": "gate.schema.json#/definitions/gate" }
  }
}
